{
  "name": "@sandbox-kit/sandbox",
  "version": "0.1.2",
  "description": "one pluggable sdk for all your sandbox providers",
  "keywords": [
    "sandbox-kit",
    "sandbox",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandbox-kit/kit.git",
    "directory": "sdks/typescript/sandbox"
  },
  "homepage": "https://github.com/sandbox-kit/kit/tree/main/sdks/typescript/sandbox",
  "bugs": {
    "url": "https://github.com/sandbox-kit/kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#client/*.js": {
      "@sandbox-kit/source": "./src/client/*.ts",
      "default": "./dist/client/*.js"
    },
    "#contracts/*.js": {
      "@sandbox-kit/source": "./src/contracts/*.ts",
      "default": "./dist/contracts/*.js"
    },
    "#metadata/*.js": {
      "@sandbox-kit/source": "./src/metadata/*.ts",
      "default": "./dist/metadata/*.js"
    },
    "#internal/*.js": {
      "@sandbox-kit/source": "./src/internal/*.ts",
      "default": "./dist/internal/*.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@sandbox-kit/contracts": "0.1.2"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
